{
    "name": "fractured-space-bootstrapper",
    "version": "2.0.0",
    "description": "Launcher and patcher for playing Fractured Space on community servers",
    "author": "Tigerhacker",
    "repository": {
        "type": "git",
        "url": "https://github.com/Tigerhacker/fractured-bootstrapper"
    },
    "main": "main.js",
    "desktopName": "fractured-space-bootstrapper.desktop",
    "scripts": {
        "start": "electron .",
        "start:linux-ui": "electron . --show-linux-settings",
        "pack": "electron-builder --dir",
        "build": "electron-builder build --win --publish never",
        "build:linux": "electron-builder build --linux --publish never",
        "hashes": "node scripts/check-hashes.js",
        "pak": "node scripts/pak.js",
        "patches:build": "node scripts/build-patches.js",
        "patches:index": "node scripts/patch-index.js",
        "release:zip": "node scripts/release-zip.js create",
        "prepack": "node scripts/check-hashes.js",
        "prebuild": "node scripts/check-hashes.js",
        "prebuild:linux": "node scripts/check-hashes.js",
        "predeploy": "node scripts/check-hashes.js",
        "postdeploy": "node scripts/release-zip.js create --upload",
        "predeploy:linux": "node scripts/check-hashes.js",
        "build:linux:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-linux-wsl.ps1",
        "deploy": "electron-builder build --win --publish always",
        "deploy:linux": "electron-builder build --linux --publish always"
    },
    "devDependencies": {
        "electron": "^45.2.1",
        "electron-builder": "^26.18.0"
    },
    "dependencies": {
        "electron-store": "^12.0.0",
        "electron-updater": "^6.8.11",
        "winreg": "^1.2.5"
    },
    "build": {
        "appId": "com.fractured.bootstrapper",
        "extraResources": [
            "./data/**"
        ],
        "files": [
            "views/**/*",
            "main.js",
            "package.json"
        ],
        "protocols": [
            {
                "name": "Fractured Space Bootstrapper",
                "schemes": [
                    "fracturedspace"
                ]
            }
        ],
        "win": {
            "target": "NSIS"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "differentialPackage": true,
            "shortcutName": "Fractured Space Bootstrapper"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "rpm"
            ],
            "category": "Game",
      "icon": "build/icons",
            "executableName": "fractured-space-bootstrapper",
            "artifactName": "FracturedSpaceBootstrapper-${arch}.${ext}",
            "maintainer": "Tigerhacker <2382883+Tigerhacker@users.noreply.github.com>",
            "synopsis": "Launcher and patcher for playing Fractured Space on community servers",
            "desktop": {
                "entry": {
                    "Name": "Fractured Space Bootstrapper",
                    "StartupWMClass": "fractured-space-bootstrapper"
                }
            },
            "syncDesktopName": true
        },
        "appImage": {
            "artifactName": "FracturedSpaceBootstrapper-${arch}.AppImage"
        }
    },
    "allowScripts": {
        "electron@45.2.1": true
    }
}
