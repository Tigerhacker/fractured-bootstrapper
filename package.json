{
    "name": "fractured-space-bootstrapper",
    "version": "1.1.0",
    "description": "Launcher and patcher for playing Fractured Space on community servers",
    "author": "Tigerhacker",
    "repository": {
        "type": "git",
        "url": "https://github.com/Tigerhacker/fractured-bootstrapper"
    },
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "build": "electron-builder build --win --publish never",
        "deploy": "electron-builder build --win --publish always"
    },
    "devDependencies": {
        "electron": "^45.2.1",
        "electron-builder": "^26.18.0"
    },
    "dependencies": {
        "electron-store": "^12.0.0",
        "electron-updater": "^6.8.11",
        "winreg": "^1.2.5"
    },
    "build": {
        "appId": "com.fractured.bootstrapper",
        "extraResources": [
            "./data/**"
        ],
        "files": [
            "views/**/*",
            "main.js",
            "package.json"
        ],
        "win": {
            "target": "NSIS"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "differentialPackage": true,
            "shortcutName": "Fractured Space Bootstrapper"
        }
    },
    "allowScripts": {
        "electron@45.2.1": true
    }
}
