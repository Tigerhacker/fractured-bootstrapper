{
    "name": "fractured-space-bootstrapper",
    "version": "1.1.0",
    "description": "Launcher and patcher for playing Fractured Space on community servers",
    "author": "Tigerhacker",
    "repository": {
        "type": "git",
        "url": "https://github.com/Tigerhacker/fractured-bootstrapper"
    },
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "build": "electron-builder build --win --publish never",
        "build:linux": "electron-builder build --linux --publish never",
        "build:linux:dir": "electron-builder build --linux dir --publish never",
        "build:all": "electron-builder build --win --linux --publish never",
        "deploy": "electron-builder build --win --publish always",
        "deploy:linux": "electron-builder build --linux --publish always",
        "deploy:all": "electron-builder build --win --linux --publish always"
    },
    "devDependencies": {
        "electron": "^23",
        "electron-builder": "22.10.5"
    },
    "dependencies": {
        "electron-store": "^8.1.0",
        "electron-updater": "^5",
        "request": "^2.88.0",
        "vdf": "0.0.2",
        "sha256-file": "^1.0.0"
    },
    "optionalDependencies": {
        "winreg": "^1.2.4"
    },
    "build": {
        "appId": "com.fractured.bootstrapper",
        "extraResources": [
            "./data/**"
        ],
        "files": [
            "views/**/*",
            "main.js",
            "package.json"
        ],
        "win": {
            "target": "NSIS"
        },
        "linux": {
            "target": [
                "AppImage",
                "dir"
            ],
            "category": "Game"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "differentialPackage": true,
            "shortcutName": "Fractured Space Bootstrapper"
        }
    }
}
